# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Virtual environments: .venv for development, .venv-build for packaging.
.venv*/

# --- Tooling ----------------------------------------------------------------
.codegraph/

# --- App runtime output (kept locally, not versioned) -----------------------
results/
.write_test
dcamapi_error.log
# Written by --self-test when it runs from a source checkout.
self-test.log
# Atomic settings writes leave this behind only if they are interrupted.
spectro_gui_settings.json.tmp

# Hama6 (C13016) operator-specific runtime files
spectrometers/micro_usb2_api_dump.txt

# --- Packaging --------------------------------------------------------------
# Build products: the frozen app (dist/SciLab) and the installer
# (dist/installer). Rebuild with packaging/build.py -- see packaging/README.md.
build/
dist/
# Generated by packaging/build.py from scilab_version.py and the logo, so they
# must never be edited by hand or committed: the committed copy would silently
# win over the generated one and could disagree with the version being built.
packaging/file_version_info.txt
packaging/*.bmp

# --- Editors / OS -----------------------------------------------------------
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
